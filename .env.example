# Copie para .env.local. Valores locais: npx supabase status
# Só a chave publicável vai aqui: ela é pública por design e a RLS protege os dados.
# Nunca coloque a secret/service_role key em variável NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Fotos (protocolo S3). Segredos: só aqui e na hospedagem, nunca no Git.
# Desenvolvimento (Supabase local): valores de `npx supabase status`
#   (STORAGE_S3_URL, S3_PROTOCOL_*), bucket "fotos", PATH_STYLE=true.
# Produção (Cloudflare R2): endpoint https://<ID_DA_CONTA>.r2.cloudflarestorage.com,
#   região "auto", chaves de um token R2 com permissão de leitura e escrita
#   só neste bucket, PATH_STYLE=false.
ARMAZENAMENTO_ENDPOINT=http://127.0.0.1:54321/storage/v1/s3
ARMAZENAMENTO_REGIAO=local
ARMAZENAMENTO_CHAVE_ID=...
ARMAZENAMENTO_CHAVE_SECRETA=...
ARMAZENAMENTO_BUCKET=fotos
ARMAZENAMENTO_PATH_STYLE=true
